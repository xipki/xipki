<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xipki.pki</groupId>
    <artifactId>xipki-parent</artifactId>
    <version>7.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>pkix-protocol</artifactId>
  <name>XiPKI :: ${project.artifactId}</name>
  <dependencies>
    <dependency>
      <groupId>org.xipki.crypto</groupId>
      <artifactId>crypto-api</artifactId>
      <version>${xicrypto.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xipki.crypto</groupId>
      <artifactId>crypto-core</artifactId>
      <version>${xicrypto.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xipki.util</groupId>
      <artifactId>pkix</artifactId>
      <version>${xiutil.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xipki.crypto</groupId>
      <artifactId>pkcs11</artifactId>
      <version>${xicrypto.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xipki.crypto</groupId>
      <artifactId>crypto-be-jdk</artifactId>
      <version>${xicrypto.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-lts8on</artifactId>
      <version>${bcprov.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the PKCS#11 token for the P11 tests -->
      <groupId>org.xipki.crypto</groupId>
      <artifactId>xihsm</artifactId>
      <version>${xicrypto.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- crypto-be-jdk: ML-DSA with context string, and the expanded ML-DSA / ML-KEM private keys
               from the seed, use the internals of the JDK -->
          <argLine>--add-exports java.base/sun.security.provider=ALL-UNNAMED --add-exports java.base/com.sun.crypto.provider=ALL-UNNAMED</argLine>
          <excludes>
            <exclude>**/SmDisabledTest.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- runs in its own JVM: the SM algorithms must be disabled before first use -->
          <execution>
            <id>sm-disabled</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes>
                <include>**/SmDisabledTest.java</include>
              </includes>
              <systemPropertyVariables>
                <xipki.crypto.disableSm>true</xipki.crypto.disableSm>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
