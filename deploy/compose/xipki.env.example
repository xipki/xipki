# XiPKI user deployment settings. Copy this file to xipki.env, or run
# ./container.sh config. Password values never belong in this file.

# Configuration contract version. Do not change it independently of the release.
XIPKI_DEPLOYMENT_FORMAT=1

# standalone: all roles run on one Docker host (default).
# distributed: record the topology used to generate role-scoped node bundles.
XIPKI_DEPLOYMENT_MODE=standalone
XIPKI_DEPLOYMENT_NAME=xipki

# Required only in distributed mode. Use stable DNS names when possible because
# the names are part of generated endpoint URLs and TLS server identities.
# XIPKI_CA_HOST=ca.internal.example.com
# XIPKI_CONSOLE_HOST=console.internal.example.com
# XIPKI_GATEWAY_HOST=gateway.example.com
# XIPKI_OCSP_HOST=ocsp.example.com

# managed: XiPKI starts the selected database container (default).
# external: connect to databases, users, grants, and XiPKI schemas prepared by a DBA.
XIPKI_DATABASE_MODE=managed

# Supported engines: mariadb or postgres.
XIPKI_DATABASE=mariadb

# Required for external databases and for the dedicated database node in distributed mode.
# The first release accepts a DNS name or IPv4 address.
# XIPKI_DB_HOST=db.example.com
# XIPKI_DB_PORT=3306

# Deployment identity and host exposure.
XIPKI_ORGANIZATION=XiPKI Evaluation
XIPKI_BIND_ADDRESS=127.0.0.1
XIPKI_CA_HTTPS_PORT=8444
XIPKI_CONSOLE_HTTPS_PORT=18081
# Plain Gateway HTTP is always published on 127.0.0.1; remote clients use HTTPS.
XIPKI_GATEWAY_HTTP_PORT=18082
XIPKI_GATEWAY_HTTPS_PORT=18445
XIPKI_OCSP_HTTP_PORT=18080

# Supported Console authentication modes: both, password, or certificate.
XIPKI_CONSOLE_AUTH_MODE=both

# In external mode, ./container.sh config securely writes the four application passwords to:
#   .state/secrets/ca_db_password
#   .state/secrets/ocsp_db_password
#   .state/secrets/gateway_db_password
#   .state/secrets/console_db_password
