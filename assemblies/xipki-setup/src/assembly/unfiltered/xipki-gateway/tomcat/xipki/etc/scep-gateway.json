{
  "scep":{
    "includeCaCert":true,
    "includeCertChain":false,
    "includeSignerCert":true,
    "supportGetCrl":true,
    "maxSigningTimeBias":300
  },
  // WARNING: Replace the simple authenticator with your own.
  "authenticator":"org.xipki.pkix.auth.SimpleRequestorAuthenticator etc/simple-requestors.json",
  // When "caProfiles" is configured, short URL is possible
  //   For all aliases:     https://<host>:<port>/.well-known/est/<alias>
  //   For alias "default": https://<host>:<port>/.well-known/est
  //
  //"caProfiles": [{
  //  "name": "default",
  //  "ca": "subca",
  //  "certprofile": "tls"
  //},{
  //  "name": "myalias",
  //  "ca": "subca",
  //  "certprofile": "tls"
  //}],
  "signers":{
    "signers":[{
      "names":["myca"],
      "signer":{
        "type":"pkcs12",
        "conf":"password=$[scep.keyPassword],keystore=file:keycerts/scep-sign.p12"
      }
    }]
  },
  "decryptors":{
    "decryptors":[{
      "names":["myca"],
      "decryptor":{
        "type":"pkcs12",
        "conf":"password=$[scep.keyPassword],keystore=file:keycerts/scep-enc.p12"
      }
    }]
  }
}
